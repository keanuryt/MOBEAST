
## Bit of code Detla values MOBEAST analysis 
### only the 12PM data analysis



## 12PM data
```{r}
# removing outliers from the data set
mobeast_12PM <- mobeast_delta %>%
  filter(time_string == "12:00:00") %>% 
  
  ## remove the outliers 
  filter(outlier == "not outlier") 



```
### Summary stats

```{r}
mobeast_12PM %>% group_by(variable,treatment) %>% 
  reframe(max = max(areal_flux, na.rm = TRUE),
          min = min(areal_flux, na.rm = TRUE),
    mean = mean(areal_flux, na.rm = TRUE),
          sd = sd(areal_flux, na.rm = TRUE))
```

```{r}
## removing the calculated outliers from the areal flux numbers 
mobeast_12PM %>% group_by(treatment, variable) %>% 
  mutate(mean = mean(areal_flux, na.rm = TRUE),
    sd = sd(areal_flux, na.rm = TRUE)) %>% 
  mutate(flux_outlier = ifelse(areal_flux > mean +2*sd | areal_flux < mean -2*sd,"outlier", "not outlier")) %>% 
  filter(variable == "het_bact") %>% 
  filter(flux_outlier != "outlier") %>% 
  ggplot(aes(x = treatment, y = areal_flux, fill = treatment)) +
      geom_violin() +
      geom_point() +
      geom_hline(yintercept = 0, linetype = "dashed") +
      stat_summary(color = "yellow", alpha = 0.5) +
      labs(title = paste("12PM Heterotrophic Bacteria Production"),
           x = "Treatment",
          y = "Areal Flux (indiv/(s.m2)") +
      scale_fill_manual(
        breaks = c("Control", "Coral", "CCA", "Algae"),
        values = c("grey", "#03A9F4", "#EF5350", "#4CAF50")
      ) +
      nunu_theme +
      theme(legend.position = "none")
```

### Lmer models  - Iterative  coding 

```{r}
# Loop Function:
## Take the 12PM samples and isolate the types of nutrient present on the df in a vector
## Create a list where the loop results will be save, named after the nutrients of the df
## In the for-loop, filter the df by nutrient and apply a statistical model with lmer
## Save the outputs of the model in the list such that each nutrient has its stats

mobeast_loop <- mobeast_12PM %>% select(variable) %>% distinct() %>% pull()

models_12PM <- vector(mode = "list", length = length(mobeast_loop))
names(models_12PM) <- mobeast_loop

for (var in mobeast_loop) {
  df <- mobeast_12PM %>% filter(variable == var)
  models_12PM[[var]] <- lmer(areal_flux~ treatment + (1|tank_number), data = df)

}

```

#### singularity test 
```{r}
## check if the model soliution is singular and/or converges
models <- mobeast_12PM %>% group_by(variable) %>%
  group_modify(~ {
    mod <- lmer(areal_flux ~ treatment + (1|tank_number), data = .x)

    tibble(
      model = list(mod),
      singular = isSingular(mod),
      converged = is.null(mod@optinfo$conv$lme4$messages)
    )
  }) %>%
  ungroup() %>% filter(singular == TRUE)
```

#### model results (fixed/random)
```{r}
# save the outputs of the model in a dataframe (fixed and random effects)
results <- imap_dfr(models_12PM, ~ tidy(.x) %>%
                     dplyr::mutate(variable = .y)) %>% 
  relocate(variable, .before = "effect")
```

#### ANOVA results
```{r, warning= FALSE}
# So many Warnings! 
## Warning: The column names NumDF and DenDF in ANOVA output were not recognized or transformed.

# run anova on the models 
anova_results <- imap_dfr(models_12PM, ~ {
  stats::anova(.x, type = 2) %>%
    broom::tidy() %>%
    mutate(variable = .y)}) %>%
  relocate(variable) 

## which variables have significant anova results
anova_results %>% filter(p.value <0.05)
```


```{}
## making sure that the code produces accurate outputs
test_12PM<- mobeast_12PM %>%  filter(variable =="npoc_u_m")
test_12PM_mod <- lmer(areal_flux ~ treatment + (1|tank_number), data = test_12PM)

anova(test_12PM_mod, type = 2)
```

#### emmeans results 
```{r}
# "estimate" are negative somehow. Why? 
## in manual models for DOC, estimate >0, here it's <0
## t.ratio in "statistics", and negative instead of positive
## p.values not shown, only p.adjusted. 
emmeans_results <- imap_dfr(models_12PM, ~ {
  emmeans(.x, pairwise ~ treatment)$contrasts %>%
    broom::tidy() %>%
    mutate(variable = .y)}) %>% 
  relocate(variable) %>% 
  filter(contrast == "Control - Coral"| contrast == "Control - CCA"|contrast == "Control - Algae") 


emmeans_results_sig <- emmeans_results %>% 
  filter(adj.p.value <0.05)

emmeans_results
emmeans_results_sig
```

```{}
## making sure that the code produces accurate outputs
emmeans(test_12PM_mod,specs = trt.vs.ctrl ~ treatment)
```


```{r}
emmean_sig <- emmeans_results_sig %>% pull(variable)
```

```{, warning=FALSE}
mobeast_12PM %>% filter(variable %in% emmean_sig) %>% 
  #filter(variable == "SiO2") %>% 
  ggplot(aes(x= treatment, y= areal_flux, fill = treatment))+
    geom_violin()+
    geom_jitter(aes(color = outlier), alpha = 0.5)+
    geom_hline(yintercept=0, linetype='dashed')+
    stat_summary(color = "yellow", alpha =0.5)+
    facet_wrap(~variable, scales = "free")+
    labs(title = paste("12PM Biogeochem Changes"),
       #subtitle = "Norm DOC = Tank DOC - Inflow DOC",
       x= "Treatment",
       y = "Flux XXX")+
  scale_fill_manual(breaks = c("Control", "Coral", "CCA", "Algae"), 
                       values=c("grey", "#03A9F4", "#EF5350", "#4CAF50"))+
  scale_color_manual(breaks = c("outlier", "not outlier"), 
                       values=c("red", "black"))+
    nunu_theme + 
    theme(axis.text = element_text(size = 18))
```


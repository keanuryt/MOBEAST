models_12PM_2 <- vector(mode = "list", length = length(mobeast_loop))
names(models_12PM_2) <- mobeast_loop

for (var in mobeast_loop) {
  df <- mobeast_12PM_flux %>% filter(variable == var)
  models_12PM_2[[var]] <- lmer(areal_flux~ treatment + (1|tank_number), data = df)

}

```


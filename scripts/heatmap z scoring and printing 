



## Z-Scored data transformation


```{r, echo=TRUE, collapse=TRUE}
#Make a heatmap of z-scored relative abundance data after it was summed by family
#https://jokergoo.github.io/ComplexHeatmap-reference/book/heatmap-annotations.html

# some the abundance of bacteria by family
family.culled.long.table <- OTU_htm_24h %>%
  group_by(id_number, family) %>%
  summarize(abund = sum(abund, na.rm = TRUE)) %>% 
  ungroup()

# Make wide format table to make a matrix later
family.culled.abund <- pivot_wider(family.culled.long.table, names_from = family, values_from = abund)

# Remove ID number from the data frame
## Z-score function only works on df that has a matrix format
culled.abund.OTU <- family.culled.abund %>% tibble() %>%  select(-id_number)

# Calculate Z-score on df/matrix
z.zscore.data.otu.subset <- as.data.frame(apply(culled.abund.OTU, 2, FUN=zscore.calculation))


```

```{r}
# bring back the sample ID number in the df 
z.zscore.data.otu.subset$id_number = family.culled.abund$id_number


# Set the ID numbers as the rownames (to make a matrix)
rownames(z.zscore.data.otu.subset) = z.zscore.data.otu.subset$id_number

# Remove the ID number column, convert the df to a matrix and transpose to make the final matrix.
zscore.data.otu.matrix <- z.zscore.data.otu.subset %>% select(-id_number) %>% 
  as.matrix() %>% t()

```


## Heatmap

#### Annotation

```{r}
## Create a vector that will have information of a variable and its associate sample 
treatment <- meta[match(colnames(zscore.data.otu.matrix),
                           meta$id_number), 
                 "treatment"]

date_time <- meta[match(colnames(zscore.data.otu.matrix),
                           meta$id_number),
                  "date_time_string"]

time <- meta[match(colnames(zscore.data.otu.matrix),
                           meta$id_number),
                  "time_string"]

```


## organize the samples (ChatGPT)
```{r}

## organize the treatment in order they will be display on the heatmap
treatment2 <- factor(treatment$treatment, levels = c("Control", "Coral", "CCA", "Algae", "Inflow"))

## organize the time in order they will be display on the heatmap
time2 <- factor(time$time_string, levels = c("12:00:00", "18:00:00", "00:00:00", "06:00:00"))

#store that info in a df
col_info <- data.frame(
  Treatment = treatment2,
  Time = time2) %>% drop_na()

# create the order in which the samples with be organize in the heatmap
sample_order <- order(col_info$Treatment,col_info$Time)

# tell the matrix with my z-scores how the samples should be arranged
mat_ordered <- zscore.data.otu.matrix[, sample_order]

# have vectors specifying the order of the treatment for the heatmap
treatment_ordered <- col_info$Treatment[sample_order]
time_ordered <- col_info$Time[sample_order]


```

```{r}
## Create Annotation for the heatmap 
col_ha <- HeatmapAnnotation(
  #Treatment = treatment_ordered,
  
  ## Creates annotations blocks from treatments
  Treatment = anno_block(
    
  gp = gpar(fill = c("grey", "#03A9F4", "#EF5350", "#4CAF50")), # choose label colors
  #choose the name of the blocks
        labels = c("Control", "Coral", "CCA", "Algae"), 
  # customize the font color, size and font type
        labels_gp = gpar(col = "white", fontsize = 14,fontface = "bold")),
  
  # Creates clustering for time
  Time = time_ordered, 
  
  #Specifying the labels and the colors of the cluster groups.
  ## here Treatment is not very useful bcs they are specified above already
  col = list(Treatment = c("Control"="grey", 
                           "Coral"="#03A9F4", "CCA"="#EF5350",
                           "Algae"="#4CAF50"),
             Time = c("12:00:00" = "black",
                          "18:00:00" = "green", 
                          "00:00:00" = "blue",
                          "06:00:00" = "grey"))
)

```



#### Printing heatmap

```{, fig.height = 10, fig.width = 16}
#Version 1: OG
#png(width=1800, height=1000, file= here("outputs", "zscore_24hdata.png"))

ht = Heatmap(zscore.data.otu.matrix, name = "z-scored", 
             #rect_gp = gpar(col = "white", lwd = 0.1),
        
        column_title = "24h Sampling - All samples", 
        column_title_gp = gpar(fontsize = 16, fontface = "bold"),
        #column_title_side = "bottom",
        cluster_rows = TRUE,
        cluster_columns =  FALSE,
        row_title = "Family",
        row_names_gp = gpar(fontsize = 10),
        column_names_gp = gpar(fontsize = 10),
        row_km = 5, #number of forced segregation in rows 
        #column_km = 4,#number of forced segregation in columns 
        top_annotation = ha
        )
set.seed(1999)
ht_drawn <- draw(ht)

#dev.off()

```




```{r, fig.height = 10, fig.width = 16}
# Version 2
#png(width=1600, height=1000, file= here("outputs", "zscore_24hdata.png"))

ht = Heatmap(mat_ordered, name = "z-scored", 
             #rect_gp = gpar(col = "white", lwd = 0.1),
        
        column_title = "Bacterial Community Shift Over 24h", 
        column_title_gp = gpar(fontsize = 18, fontface = "bold"),
        #column_title_side = "bottom",
        cluster_rows = TRUE,
        cluster_columns =  FALSE,
        row_title = "Bacterial Families",
        row_title_gp = gpar(fontsize = 14, fontface = "bold"),
        row_names_gp = gpar(fontsize = 11),
        row_dend_width = unit(1.5, "cm"),
        #column_names_gp = gpar(fontsize = 10),
        show_column_names = FALSE,
        row_km = 4, # 5? number of forced segregation in rows 
        #column_km = 4,#number of forced segregation in columns 
        top_annotation = col_ha,
        #bottom_annotation = col_ha,
        column_split = treatment_ordered
        )
set.seed(1999)
ht_drawn <- draw(ht)

#dev.off()


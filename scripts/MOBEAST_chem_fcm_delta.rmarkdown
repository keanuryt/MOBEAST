```{r}
nunu_theme_pub <- theme_test()+ 
  theme(plot.title = element_text(size=16, face = "bold"), 
        axis.title = element_text(size = 10, face = "bold"),
        axis.text = element_text(size = 9),
        legend.text=element_text(size=9),
        #strip.background = element_rect(fill = "white"),
        legend.position = "none"
        )
```

```{r}

# --- 1. Prep the contrasts dataframe ---------------------------------------
# Assumes "contrast" looks like "p1-3K - wt" (emmeans default separator " - ")
# Adjust the split pattern if yours differs (e.g. "p1-3K/wt" or "p1-3K vs wt")

contrasts_clean <- emmeans_results %>%
  mutate(
    group1 = str_trim(str_split_fixed(contrast, " - ", 2)[, 2]),  # reference, e.g. "wt"
    group2 = str_trim(str_split_fixed(contrast, " - ", 2)[, 1]),  # comparison, e.g. "p1-3K"
    p.adj.signif = case_when(
      adj.p.value <= 0.0001 ~ "****",
      adj.p.value <= 0.001  ~ "***",
      adj.p.value <= 0.01   ~ "**",
      adj.p.value <= 0.05   ~ "*",
      TRUE ~ "ns"
    )
  ) %>% 
  filter(p.adj.signif != "ns")   # drop non-significant, matches the figure (only sig. shown)


# --- 2. Loop over variables --------------------------------------------------

graph_loop <- mobeast_24h %>% select(variable) %>% distinct() %>% pull()
plots_24h <- vector(mode = "list", length = length(graph_loop))


for (var in graph_loop) {
  
  df_var <- mobeast_24h %>% filter(variable == var)
  
  unit_plot <- df_var %>% select(units) %>% distinct()
  
  variable_name <- df_var %>% 
    select(variable_clean) %>% distinct()
  
  inflow_val <- avg_inflow %>% filter(variable == var) %>% pull(avg_value)
  print(paste(var, ":", inflow_val))
  
  # capture inflow_val as DATA, not as a symbol to be looked up later
  inflow_df <- data.frame(
    yint = inflow_val,
    lty  = "Averaged Inflow")
  
  # bake inflow_val into the formula as a literal number, not a lazy symbol
  sec_axis_formula <- as.formula(paste0("~ . + ", inflow_val))
  
  contrasts_var <- contrasts_clean %>%
    filter(variable == var)
  
  # y.position for brackets, staggered above the max data point
  if (nrow(contrasts_var) > 0) {
    y_max <- max(df_var$conc_norm, na.rm = TRUE)
    y_range <- diff(range(df_var$conc_norm, na.rm = TRUE))
    
    contrasts_var <- contrasts_var %>%
      arrange(group2) %>%
      mutate(y.position = y_max + y_range * 0.2 * row_number())  # a bit more spacing since "ns" adds rows
  }
  
  p <- df_var %>%
    ggplot(aes(x = treatment, y = conc_norm, fill = treatment)) +
    geom_boxplot(width = 0.5, outlier.shape = NA) +
    geom_jitter(color = "black", alpha = 0.5, width = 0.25) +
    geom_hline(aes(yintercept = 0, linetype = "Zero")) +
    geom_hline(aes(yintercept = 0, linetype = "Averaged Inflow"), color = "red") +
    #geom_hline(data = inflow_df, aes(yintercept = yint, linetype = lty), color = "red") +
    stat_summary(color = "yellow", alpha = 0.5) +
    stat_summary(color = "yellow", alpha = 0.5) +
    labs(x= "Treatment",
       y = paste0("Delta ", variable_name, " (",unit_plot, ")"))+
    scale_fill_manual(breaks = c("Control", "Coral", "CCA", "Algae"),
                       values = c("grey", "#03A9F4", "#EF5350", "#4CAF50")) +
    scale_y_continuous(
      sec.axis = sec_axis(transform = sec_axis_formula, name = "Raw Values", guide = )
    )+
    scale_linetype_manual(
    name = NULL,
    values = c("Zero" = "dashed", "Averaged Inflow" = "dotdash"))+
  guides(fill = "none")+
    nunu_theme_pub #+
    #theme(legend.position = "bottom")
  
  if (nrow(contrasts_var) > 0) {
    p <- p + stat_pvalue_manual(
      contrasts_var,
      label = "p.adj.signif",
      xmin = "group1",
      xmax = "group2",
      y.position = "y.position",
      tip.length = 0.01,
      label.size = 5,      # size of the "*"/"ns" text — bump up from ggpubr's default of ~3.88
      bracket.size = 0.6   # thickness of the bracket lines — default is 0.3
    )

  }
  
  plots_24h[[var]] <- p
}
```






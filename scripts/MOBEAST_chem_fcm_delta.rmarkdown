##### Nutrients 



```{r,message=FALSE, fig.width = 13, fig.height = 8}
mobeast_24h %>% 
   filter(variable %in% c("NO3", "PO4", "NH3", "SiO2", "chla_conc")) %>% 
  mutate(variable = recode_values(variable,
      "NO3"      ~"Nitrate",
      "PO4"       ~ "Phosphate",
      "NH3" ~ "Ammonia",
      "SiO2" ~ "Silicate",
      "chla_conc" ~ "Chlorophyll a"
    )) %>% 
  mutate(variable= factor(variable, levels = c("Nitrate",  "Ammonia", "Phosphate", "Silicate", "Chlorophyll a"))) %>% 
  ggplot(aes(x= treatment, y= conc_norm, fill = treatment))+
    geom_violin()+
    #geom_jitter(aes(color = outlier), alpha = 0.5)+
    geom_hline(yintercept=0, linetype='dashed')+
    stat_summary(color = "yellow", alpha =0.5)+
    facet_grid( variable ~ time_fac, scales = "free" )+
    labs(
       #subtitle = "Norm DOC = Tank DOC - Inflow DOC",
       x= "Treatment",
       y = paste0("Delta Nutrients (µM)"))+
  scale_fill_manual(breaks = c("Control", "Coral", "CCA", "Algae"), 
                       values=c("grey", "#03A9F4", "#EF5350", "#4CAF50"))+
  scale_color_manual(breaks = c("outlier", "not outlier"), 
                       values=c("red", "black"))+
    nunu_theme + 
    theme(axis.text = element_text(size = 18),
          legend.position = "none")

ggsave(filename = "nutrient_chla_plot.png" , plot = last_plot(), height = 8, width = 13,path = here("outputs"))
```




#### Summary Stats for Thesis



```{r}
mobeast_delta %>% filter(variable %in% sig_anova) %>% 
  group_by(variable, time, treatment) %>% 
  reframe(mean = mean(conc_norm, na.rm = TRUE),
          sd = sd(conc_norm, na.rm = TRUE))
```



## DOM x Het Bact


```{r}
mobeast_wide <- mobeast_24h %>% select(tank_number, treatment, inflow_table, 
                       time_fac,variable, conc_norm, log_flow) %>% 
  pivot_wider(names_from = variable, values_from = conc_norm)
```




### HIX 


```{r}
mod_hix <- lm(het_bact ~ hix + treatment + log_flow , 
                  data= mobeast_wide)
anova(mod_hix)
contrast(emmeans(mod_hix, ~treatment), methods= "trt.vs.ctrl")

ggplot(mobeast_wide, aes(hix, het_bact, color = treatment,group= treatment))+
  geom_point()+
  geom_smooth(method = "lm",se = F)+
  facet_wrap(.~treatment)+
  scale_color_manual(values = treatment_colors)+
  nunu_theme

ggplot(mobeast_wide, aes(hix, het_bact, fill = treatment,group= treatment))+
  geom_violin()+
  facet_wrap(.~treatment, nrow=1)+
  stat_summary(alpha = 0.5)+
  scale_fill_manual(values = treatment_colors)+
  nunu_theme
```



### Coble C



```{r}
mod_cobC <- lm(het_bact ~ coble_c + treatment + log_flow , 
                  data= mobeast_wide)
anova(mod_cobC)
contrast(emmeans(mod_cobC, ~treatment), methods= "trt.vs.ctrl")

ggplot(mobeast_wide, aes(coble_c, het_bact, color = treatment,group= treatment))+
  geom_point()+
  geom_smooth(method = "lm",se = F)+
  facet_wrap(.~treatment, nrow=1)+
  scale_color_manual(values = treatment_colors)+
  nunu_theme

ggplot(mobeast_wide, aes(coble_c, het_bact, fill = treatment,group= treatment))+
  geom_violin()+
  facet_wrap(.~treatment, nrow=1)+
  stat_summary(alpha = 0.5)+
  scale_fill_manual(values = treatment_colors)+
  nunu_theme
```





### Plots 




```{r}
# Define shading dataframe matching your exact factor levels
# Adjust period assignments to match your actual day/night schedule
shading <- data.frame(
  time_fac = levels(mobeast_24h$time_fac),
  period   = c("day", "night", "night", "day")  # adjust to your time points
)

ta <- mobeast_24h %>% 
  filter(variable == "ta") %>% 
  group_by(variable, time_fac, treatment) %>% 
  reframe(mean = mean(conc_norm, na.rm = T),
          sd   = sd(conc_norm, na.rm = T)) %>% 
  ggplot(aes(x = time_fac, y = mean, color = treatment, group = treatment)) +
  # Day/night shading — added before geom_point and geom_line
  geom_tile(
    data = shading,
    aes(x = time_fac, y = 0, fill = period),
    height = Inf, alpha = 0.3,
    inherit.aes = FALSE
  ) +
  scale_fill_manual(
    values = c("day" = "lightyellow", "night" = "lightblue"),
    name   = "Period"
  ) +
  geom_point() +
  geom_line(aes(color = treatment)) +
  geom_hline(yintercept = 0, linetype = 'dashed') +
  facet_grid(treatment ~ .) +
  labs(title = "Total Alkalinity ",
    x = "Time Point",
    y = paste0("Delta TA (µmol/kg)")
  ) +
  scale_color_manual(
    breaks = c("Control", "Coral", "CCA", "Algae"),
    values = c("grey", "#03A9F4", "#EF5350", "#4CAF50")
  ) +
  nunu_theme +
  theme(
    axis.text       = element_text(size = 18),
    legend.position = "none"
  )

ph <- mobeast_24h %>% 
  filter(variable == "ph") %>% 
  group_by(variable, time_fac, treatment) %>% 
  reframe(mean = mean(conc_norm, na.rm = T),
          sd   = sd(conc_norm, na.rm = T)) %>% 
  ggplot(aes(x = time_fac, y = mean, color = treatment, group = treatment)) +
  # Day/night shading — added before geom_point and geom_line
  geom_tile(
    data = shading,
    aes(x = time_fac, y = 0, fill = period),
    height = Inf, alpha = 0.3,
    inherit.aes = FALSE
  ) +
  scale_fill_manual(
    values = c("day" = "lightyellow", "night" = "lightblue"),
    name   = "Period"
  ) +
  geom_point() +
  geom_line(aes(color = treatment)) +
  geom_hline(yintercept = 0, linetype = 'dashed') +
  facet_grid(treatment ~ .) +
  labs(title = "pH",
    x = "Time Point",
    y = paste0("Delta pH")
  ) +
  scale_color_manual(
    breaks = c("Control", "Coral", "CCA", "Algae"),
    values = c("grey", "#03A9F4", "#EF5350", "#4CAF50")
  ) +
  nunu_theme +
  theme(
    axis.text       = element_text(size = 18),
    legend.position = "none"
  )

ta + ph
```

